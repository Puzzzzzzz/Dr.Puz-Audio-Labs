{
  "name": "dr-puz-audio-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Lokalny odtwarzacz audio i wideo dla Windows.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win nsis",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1",
    "verify:win-signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-win-signatures.ps1",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "systeminformation": "^5.23.8",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^27.0.0-alpha.14",
    "electron-vite": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "pl.drpuz.audiolab",
    "productName": "Dr.Puz Audio Lab",
    "forceCodeSigning": true,
    "directories": {
      "output": "release"
    },
    "fileOptions": {
      "files": [
        "out/**/*",
        "package.json"
      ]
    },
    "win": {
      "icon": "buildResources/drpuz-mark.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "DrPuz-Audio-Lab-${version}-Setup.${ext}",
      "signExts": [
        ".exe",
        ".dll"
      ],
      "sign": {
        "type": "signtool",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "buildResources/drpuz-mark.ico",
      "uninstallerIcon": "buildResources/drpuz-mark.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.25.12": true
  }
}
